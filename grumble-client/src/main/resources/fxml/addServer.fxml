<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="420.0" spacing="10.0" stylesheets="@../styles/dark-theme.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gg.grumble.client.controllers.AddServerController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <children>
        <GridPane hgap="10.0" vgap="8.0" VBox.vgrow="ALWAYS">
            <columnConstraints>
                <ColumnConstraints minWidth="80.0" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
            </rowConstraints>
            <children>
                <TextField fx:id="addressField" text="127.0.0.1" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label labelFor="$addressField" mnemonicParsing="true" text="_Address" GridPane.rowIndex="0" />

                <TextField fx:id="portField" text="64738" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label labelFor="$portField" mnemonicParsing="true" text="_Port" GridPane.rowIndex="1" />

                <TextField fx:id="usernameField" promptText="Your username" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label labelFor="$usernameField" mnemonicParsing="true" text="_Username" GridPane.rowIndex="2" />

                <TextField fx:id="labelField" promptText="Local server label" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                <Label labelFor="$labelField" mnemonicParsing="true" text="_Label" GridPane.rowIndex="3" />
            </children>
        </GridPane>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button fx:id="okButton" defaultButton="true" onAction="#onOk" text="OK" />
                <Button cancelButton="true" onAction="#onCancel" text="Cancel" />
            </children>
        </HBox>
    </children>
</VBox>
